{
  "name": "hunar-os",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node scripts/run-e2e.mjs",
    "test:e2e:release": "node scripts/run-e2e.mjs && node scripts/run-e2e.mjs",
    "test:evals": "vitest run --config vitest.evals.config.ts",
    "release:evidence": "node scripts/release-evidence.mjs",
    "seed": "node scripts/seed.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/anek-devanagari": "^5.2.7",
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@fontsource/noto-sans": "^5.2.8",
    "@fontsource/noto-sans-devanagari": "^5.2.8",
    "convex": "^1.25.4",
    "next": "^15.3.2",
    "openai": "^4.103.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20.17.50",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@tailwindcss/postcss": "^4.1.7",
    "convex-test": "^0.0.38",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.2",
    "jsdom": "^26.1.0",
    "prettier": "^3.5.3",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "vitest": "^3.1.4"
  }
}
