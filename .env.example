# Public: safe to expose in the browser when Convex is connected.
NEXT_PUBLIC_CONVEX_URL=

# Server-only provider credentials. Never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
SARVAM_API_KEY=

# Explicit feature flags; disabled by default.
FEATURE_VOICE_CAPTURE=false
FEATURE_OPENAI_MAPPING=false
