# Public: safe to expose in the browser when Convex is connected.
NEXT_PUBLIC_CONVEX_URL=

# Server-only provider credentials. Never prefix these with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL_INTERPRETER=gpt-5.6-terra
SARVAM_API_KEY=
DEMO_SESSION_COOKIE_SECRET=
DEMO_CONTACT_ENCRYPTION_KEY=

# Local development only. Production fails closed until an authorised provider is added.
PRIVATE_RESULT_DELIVERY_PROVIDER=DEMONSTRATION

# Explicit feature flags; disabled by default.
FEATURE_VOICE_CAPTURE=false
FEATURE_OPENAI_MAPPING=false
FEATURE_FIXTURE_MODE=false

# Local browser-test persistence only. Production demo runs use Convex.
DEMO_FIXTURE_STORE_PATH=.demo-fixture/runs.json
